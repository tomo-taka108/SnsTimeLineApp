# 環境変数のテンプレート（docs/07_architecture.md 5章）
#
#   cp .env.example .env
#
# 注意: Spring Boot は .env を自動では読み込まない。
#       このファイルは「IDEの実行構成やシェルに設定する値の転記元」として使う。
#       application.yml の既定値がこのファイルと一致しているため、
#       実際に設定が必要なのは JWT_SECRET だけ。
#
# .env は絶対にコミットしないこと（.gitignore で除外済み）。

# ===== データベース =====
DB_URL=jdbc:postgresql://localhost:5432/snstimeline
DB_USERNAME=snsapp
DB_PASSWORD=password

# ===== JWT =====
# 32バイト以上のランダム文字列を設定すること。
# 未設定だとアプリの起動に失敗する（弱い鍵で署名し続けるより明確に落とすため）。
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
#   bash      : openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_32_BYTES_OR_LONGER_SECRET
JWT_EXPIRATION_HOURS=24

# ===== ファイルストレージ（未実装。将来のために定義だけしておく） =====
APP_STORAGE_TYPE=LOCAL
APP_STORAGE_LOCAL_PATH=./uploads
APP_UPLOAD_MAX_SIZE_MB=5
APP_UPLOAD_MAX_COUNT=1

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:5173
