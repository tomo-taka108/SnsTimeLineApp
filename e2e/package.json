{
  "name": "snstimeline-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "E2Eテスト（Playwright）とブラウザパフォーマンステスト。frontend からは独立している",
  "scripts": {
    "test": "playwright test",
